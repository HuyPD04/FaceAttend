MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=faceattend
DATA_DIR=data
FAISS_INDEX_PATH=data/faiss/templates.index
FERNET_KEY_FILE=data/fernet.key

FACEATTEND_ENCRYPTION_KEY=

ONNX_PROVIDERS=CPUExecutionProvider
DETECTOR_MODEL_PATH=data/models/models/buffalo_l/det_10g.onnx
DETECTOR_MODEL_ID=scrfd-10g-bnkps-v1
DETECTOR_INPUT_SIZE=640
DETECTOR_THRESHOLD=0.50
DETECTOR_NMS_THRESHOLD=0.40
RECOGNIZER_MODEL_PATH=data/models/models/buffalo_l/w600k_r50.onnx
RECOGNIZER_MODEL_ID=arcface-w600k-r50-v1
RECOGNIZER_INPUT_SIZE=112
RECOGNIZER_PREPROCESS_VERSION=arcface-112x112-5pt-v1
EMBEDDING_DIMENSION=512
MATCH_THRESHOLD=0.48
MATCH_MARGIN=0.06
DUPLICATE_THRESHOLD=0.62
MIN_FACE_PIXELS=120
MIN_DETECTION_SCORE=0.80
MIN_SHARPNESS=60
MIN_BRIGHTNESS=45
MAX_BRIGHTNESS=215
MAX_ENROLLMENT_YAW_DEGREES=28
MAX_ENROLLMENT_ROLL_DEGREES=15
CONFIRMATION_FRAMES=3
CONFIRMATION_WINDOW_SECONDS=2.0
ATTENDANCE_COOLDOWN_SECONDS=600
ENROLLMENT_TARGET_SAMPLES=5
ENROLLMENT_MIN_SAMPLES=3
ENROLLMENT_DUPLICATE_SIMILARITY=0.997
LIVENESS_MODE=disabled
LIVENESS_MODEL_PATH=data/models/liveness.onnx
LIVENESS_THRESHOLD=0.90
LIVENESS_INPUT_SIZE=80
LIVENESS_REAL_CLASS_INDEX=1
REVIEW_EVIDENCE_ENABLED=true
REVIEW_EVIDENCE_MAX_PIXELS=240
REVIEW_COOLDOWN_SECONDS=60
